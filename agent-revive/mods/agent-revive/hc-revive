#!/bin/zsh
# Resume agents in Herdr desktop (herdr-core) terminals after a reboot. The core only gives a lost terminal a shell.
# hc-revive save            write the snapshot: each local agent terminal and the command that resumes it
# hc-revive restore [file]  type the resume command into each saved terminal that is back at its shell
# hc-revive tick            for the mod's timer: restore once after a reboot, then save
set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
state=${HC_REVIVE_STATE:-~/.local/state/hc-revive}
snap=$state/snapshot.json
pending=$state/pending.json
mkdir -p $state
boot() { sysctl -n kern.boottime | sed -E 's/^\{ sec = ([0-9]+).*/\1/'; }
uuid='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'

# One local live kept terminal per line: address, root pid.
terminals() {
  hc ls --json | jq -r '.terminals[].address | select(contains("/") | not)' | while read -r t; do hc get $t --json; done |
    jq -r 'select(.state == "live" and .keep) | [.address, .pid] | @tsv'
}

# One line (address, folder, resume command) for each terminal that runs a known agent.
# One ps and one lsof do the work.
agents() {
  local t pid tty comm kind val f tab=$'\t'
  typeset -A root tty_of addr_of cwd_of entry
  local -a others
  terminals | while IFS=$'\t' read -r t pid; do root[$t]=$pid; done
  (( $#root )) || return 0
  # One ps for everything: each ps call costs a third of a second here, however few processes it names.
  ps -axo pid=,tty=,comm= | while read -r pid tty comm; do
    [[ $tty == '??' ]] && continue
    tty_of[$pid]=$tty
    [[ ${comm:t} == (codex|agy)* ]] && others+=($pid)
  done
  for t pid in ${(kv)root}; do [[ -n ${tty_of[$pid]:-} ]] && addr_of[${tty_of[$pid]}]=$t; done
  (( $#addr_of )) || return 0
  # Codex holds its rollout files open, and agy its conversation folder. The open rollouts are often
  # sub-agent threads; session_id in the first line names the root.
  (( $#others )) && lsof -a -p ${(j:,:)others} -d cwd,0-9999 -Fpfn 2>/dev/null | awk '
    /^p/ { pid = substr($0, 2) } /^f/ { fd = substr($0, 2) }
    /^n/ { n = substr($0, 2)
      if (fd == "cwd") print pid "\tcwd\t" n
      else if (n ~ /\/rollout-.*\.jsonl$/) print pid "\tcodex\t" n
      else if (match(n, /antigravity-cli\/brain\/[0-9a-f-]+/)) print pid "\tagy\t" substr(n, RSTART + 22, RLENGTH - 22) }' |
  while IFS=$'\t' read -r pid kind val; do
    t=${addr_of[${tty_of[$pid]}]:-}
    [[ -n $t ]] || continue
    [[ $kind == cwd ]] && { cwd_of[$pid]=$val; continue; }
    [[ -n ${entry[$t]:-} ]] && continue
    [[ $kind == codex ]] && entry[$t]=$(head -1 $val | jq -r '[.payload.cwd, "codex resume \(.payload.session_id)"] | @tsv')
    [[ $kind == agy ]] && entry[$t]="${cwd_of[$pid]}${tab}agy --conversation $val"
  done
  # Claude writes one file per live process, and wins over a codex or agy that it started.
  local -a files=(~/.claude/sessions/*.json(N))
  (( $#files )) && jq -r '[input_filename, .cwd, "claude --resume \(.sessionId)"] | @tsv' $files |
  while IFS=$'\t' read -r f val kind; do
    t=${addr_of[${tty_of[${f:t:r}]:-none}]:-}
    [[ -n $t ]] && entry[$t]="$val$tab$kind"
  done
  for t in ${(k)entry}; do [[ -n ${entry[$t]} ]] && print -r -- "$t$tab${entry[$t]}"; done
}

save() {
  local out=$state/.snapshot.$$
  local entries=$(agents)
  # An empty list right after a reboot must not replace the snapshot that restore still needs.
  [[ -n $entries ]] || { echo "no agent terminals found; snapshot left as it was"; return 0; }
  [[ -f $snap ]] || echo '{"terminals": []}' > $snap
  # A shutdown stops the agents one by one, so an agent that is gone stays saved for 5 minutes.
  jq -Rs --argjson boot $(boot) --argjson now $(date +%s) --slurpfile old $snap '
    [split("\n")[] | select(length > 0) | split("\t") | {address: .[0], cwd: .[1], cmd: .[2], seen: $now}] as $new
    | {boot: $boot, terminals: ($new + [$old[0].terminals[]
        | select((.seen // 0) > $now - 300 and (.address as $a | $new | all(.address != $a)))])}' <<<$entries > $out && mv $out $snap
  jq -r '.terminals[] | [.address, .cmd, .cwd] | @tsv' $snap
}

# Prints the entries it could not revive yet (still pending), as JSON lines.
restore() {
  local file=${1:-$snap}
  jq -c '.terminals[]' $file | while read -r e; do
    t=$(jq -r .address <<<$e)
    info=$(hc get $t --json 2>/dev/null)
    if [[ $(jq -r '.state == "live" and (.foreground == null or .foreground.pid == .pid)' <<<$info 2>/dev/null) == true ]]; then
      hc send $t "$(jq -r '"cd \(.cwd | @sh) && \(.cmd)"' <<<$e)" >/dev/null && { echo "revived $t" >&2; sleep 0.1; continue; }
    fi
    [[ $(jq -r '.state // "gone"' <<<$info 2>/dev/null) == live ]] && echo "skip $t: busy" >&2 || echo "skip $t: not live" >&2
    echo $e
  done
}

case "${1:-}" in
save) save ;;
restore) restore ${2:-} >/dev/null ;;
tick)
  hc server status --json >/dev/null 2>&1 || exit 0
  # Every Herdr window runs this mod: one tick at a time, and one save a minute between them.
  find $state/lock -maxdepth 0 -mmin +5 -exec rmdir {} \; 2>/dev/null
  mkdir $state/lock 2>/dev/null || exit 0
  trap 'rmdir $state/lock' EXIT
  now=$(boot)
  [[ -f $snap && ! -f $pending && $(jq .boot $snap) == $now && $(( $(date +%s) - $(stat -f %m $snap) )) -lt 45 ]] && exit 0
  [[ -f $snap && ! -f $pending && $(jq .boot $snap) != $now ]] && jq '. + {tries: 0}' $snap > $pending
  if [[ -f $pending ]]; then
    tries=$(jq .tries $pending)
    left=$(restore $pending | jq -s --argjson n $((tries + 1)) '{tries: $n, terminals: .}')
    # A terminal the core recovers late gets another try; one the user reused stays skipped.
    if [[ $(jq '.terminals | length' <<<$left) == 0 || $tries -ge 9 ]]; then rm $pending; else echo $left > $pending; exit 0; fi
  fi
  save >/dev/null ;;
*) sed -n 3,5p $0; exit 2 ;;
esac
