#!/bin/zsh
# Opens another Herdr window: a second app process with its own home, on the same herdr-core session.
src=~/.config/herdr-app
n=2
# A home is live when its app answers status within 3 seconds (macOS has no timeout command).
while HERDR_APP_HOME=~/.config/herdr-app-$n perl -e 'alarm 3; exec @ARGV' herdr-app status >/dev/null 2>&1; do n=$((n+1)); done
home=~/.config/herdr-app-$n
mkdir -p $home/layouts $home/mods $home/data
# shortcut: copies, not symlinks (live reload through symlinks is untested); edit only ~/.config/herdr-app, since each launch overwrites these.
# shared.json carries the shown layout and mod state, so every window starts like the main one.
for f in keys.json settings.json programs.json shared.json; do [[ -f $src/$f ]] && rsync -a $src/$f $home/; done
# -c: leave identical files untouched, so a running window does not reload them.
rsync -ac --exclude .state $src/layouts/ $home/layouts/
rsync -ac $src/mods/ $home/mods/
env -u HC_TERMINAL_ID -u HC_TERMINAL_SOCKET -u HC_SCOPE open -n -a ~/Applications/Herdr.app --env HERDR_APP_HOME=$home
